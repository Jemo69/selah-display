{
  "name": "selah-display",
  "version": "6.17.0",
  "productName": "Selah",
  "description": "Selah — worship display software: real-time lyrics, Bible, sermon assist, and multi-output projection for live church services",
  "author": {
    "name": "Jemo",
    "url": "https://github.com/Jemo69"
  },
  "contributors": [
    "Peter Alakembi (creator of LyricDisplay, the project this is based on)",
    "David Okaliwe (co-creator of LyricDisplay)"
  ],
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "server": "node server/index.js",
    "electron-dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5174 && electron .\"",
    "electron": "electron .",
    "update-version": "node scripts/update-version.js",
    "electron-test": "npm run build && electron-builder --dir",
    "electron-pack": "npm run build && electron-builder",
    "electron-pack:win": "npm run build && electron-builder --win",
    "electron-pack:mac": "npm run build && electron-builder --mac",
    "electron-pack:linux": "npm run build && electron-builder --linux",
    "version": "node scripts/update-version.js && git add README.md \"INSTALLATION.md\"",
    "release": "node scripts/release.js",
    "release:mobile": "node scripts/mobile-release.js",
    "postinstall": "cd server && npm install",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.0.5",
    "@tanstack/hotkeys": "^0.8.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "fast-xml-parser": "^5.4.2",
    "font-list": "^2.0.1",
    "framer-motion": "^12.23.24",
    "fuse.js": "^7.1.0",
    "idb": "^8.0.3",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "keytar": "^7.9.0",
    "lucide-react": "^0.556.0",
    "mammoth": "^1.12.1",
    "multer": "^2.1.1",
    "paradox-reader": "^1.9.4",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.7.1",
    "react-window": "^2.2.0",
    "rollup": "^4.52.4",
    "smart-buffer": "^4.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^37.2.5",
    "electron-builder": "^24.13.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prompts": "^2.4.2",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.6",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.lyricdisplay",
    "productName": "Selah",
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "main/**/*",
      "public/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "speech-engine/**/*",
      "!speech-engine/models/**",
      "!speech-engine/bin/**",
      "!speech-engine/test/**"
    ],
    "asarUnpack": [
      "dist/**/*",
      "server/**/*",
      "preload.js",
      "shared/**/*",
      "speech-engine/**/*"
    ],
    "extraResources": [
      {
        "from": "server/node_modules",
        "to": "app.asar.unpacked/server/node_modules"
      }
    ],
    "extraFiles": [
      {
        "from": "INSTALLATION.md",
        "to": "INSTALLATION.md"
      }
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "public/favicon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-Windows-Setup.${ext}",
      "fileAssociations": [
        {
          "ext": "lrc",
          "name": "LRC Lyric File",
          "description": "Lyric file with timestamps",
          "icon": "public/favicon.ico",
          "role": "Editor"
        },
        {
          "ext": "txt",
          "name": "Text File",
          "description": "Plain text lyric file",
          "icon": "public/favicon.ico",
          "role": "Editor"
        },
        {
          "ext": "ldset",
          "name": "Selah Setlist",
          "description": "Selah setlist file",
          "icon": "public/favicon.ico",
          "role": "Editor"
        },
        {
          "ext": "ldsch",
          "name": "Selah Run-sheet",
          "description": "Selah service run-sheet file",
          "icon": "public/favicon.ico",
          "role": "Editor"
        },
        {
          "ext": "docx",
          "name": "Word Document",
          "description": "Word document importable as lyrics",
          "icon": "public/favicon.ico",
          "role": "Editor"
        },
        {
          "ext": "rtf",
          "name": "Rich Text Document",
          "description": "Rich Text document importable as lyrics",
          "icon": "public/favicon.ico",
          "role": "Editor"
        },
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown document importable as lyrics",
          "icon": "public/favicon.ico",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowElevation": false,
      "installerIcon": "public/favicon.ico",
      "uninstallerIcon": "public/favicon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Selah"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/favicon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Selah listens to the sermon microphone only while Sermon Assist is turned on, so it can suggest the next lyric line and the Bible verse being quoted. Audio is processed on this computer and is not recorded unless you enable transcript history.",
        "NSAudioCaptureUsageDescription": "Needed when you choose a mixer or system-audio input (a loopback or aggregate device) as the Sermon Assist audio source, so Selah can capture that audio for live transcription. Audio is processed on this computer and is not recorded unless you enable transcript history."
      },
      "fileAssociations": [
        {
          "ext": "lrc",
          "name": "LRC Lyric File",
          "description": "Lyric file with timestamps",
          "role": "Editor"
        },
        {
          "ext": "txt",
          "name": "Text File",
          "description": "Plain text lyric file",
          "role": "Editor"
        },
        {
          "ext": "ldset",
          "name": "Selah Setlist",
          "description": "Selah setlist file",
          "role": "Editor"
        },
        {
          "ext": "ldsch",
          "name": "Selah Run-sheet",
          "description": "Selah service run-sheet file",
          "role": "Editor"
        },
        {
          "ext": "docx",
          "name": "Word Document",
          "description": "Word document importable as lyrics",
          "role": "Editor"
        },
        {
          "ext": "rtf",
          "name": "Rich Text Document",
          "description": "Rich Text document importable as lyrics",
          "role": "Editor"
        },
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown document importable as lyrics",
          "role": "Editor"
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.png",
      "category": "AudioVideo",
      "artifactName": "${productName}-${version}-Linux.${ext}",
      "maintainer": "Peter Alakembi <alakembipeter30@gmail.com>",
      "desktop": {
        "Name": "Selah",
        "Comment": "Professional real-time lyric display",
        "Categories": "AudioVideo;Audio;Music;",
        "MimeType": "text/plain;text/rtf;text/markdown;application/x-lrc;"
      },
      "fileAssociations": [
        {
          "ext": "lrc",
          "name": "LRC Lyric File",
          "description": "Lyric file with timestamps",
          "mimeType": "application/x-lrc"
        },
        {
          "ext": "txt",
          "name": "Text File",
          "description": "Plain text lyric file",
          "mimeType": "text/plain"
        },
        {
          "ext": "ldset",
          "name": "Selah Setlist",
          "description": "Selah setlist file",
          "mimeType": "application/x-ldset"
        },
        {
          "ext": "ldsch",
          "name": "Selah Run-sheet",
          "description": "Selah service run-sheet file",
          "mimeType": "application/x-ldsch"
        },
        {
          "ext": "docx",
          "name": "Word Document",
          "description": "Word document importable as lyrics",
          "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        },
        {
          "ext": "rtf",
          "name": "Rich Text Document",
          "description": "Rich Text document importable as lyrics",
          "mimeType": "text/rtf"
        },
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown document importable as lyrics",
          "mimeType": "text/markdown"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jemo69",
        "repo": "selah-display",
        "releaseType": "release"
      }
    ]
  }
}
